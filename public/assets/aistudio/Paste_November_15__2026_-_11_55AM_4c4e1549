          <button
            type="submit"
            className="px-8 py-3 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 text-white font-bold rounded-xl transition shadow-lg shadow-indigo-200 flex items-center gap-2"
          >
            <ShieldCheck className="w-5 h-5" /> Save & Enforce Security Policies
          </button>
        </div>

      </form>

      {/* TOTP Modal */}
      {showTotpModal && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div className="flex items-center justify-between pb-3 border-b border-slate-100">
              <h3 className="text-lg font-bold text-slate-900 flex items-center gap-2">
                <Key className="w-5 h-5 text-violet-600" /> Main Admin TOTP Setup
              </h3>
              <button onClick={() => setShowTotpModal(false)} className="text-slate-400 hover:text-slate-600 font-bold text-lg">&times;</button>
            </div>
            
            <div className="text-center space-y-3">
              <div className="w-40 h-40 bg-slate-100 border-2 border-dashed border-slate-300 rounded-2xl mx-auto flex flex-col items-center justify-center p-4">
                <QrCode className="w-16 h-16 text-slate-700 mb-1" />
                <span className="text-[10px] text-slate-400 font-mono">otpauth://totp/MUN:Admin?secret=JBSWY3DPEHPK3PXP</span>
              </div>
              <p className="text-xs text-slate-500">Scan this QR code using Google Authenticator, Authy, or Aegis app.</p>
            </div>

            <div className="space-y-2">
              <label className="text-xs font-bold text-slate-700 uppercase tracking-wider">Single-Use Backup Recovery Codes (8)</label>
              <div className="grid grid-cols-2 gap-2 bg-slate-50 p-3 rounded-xl border border-slate-200 font-mono text-xs text-slate-800">
                {backupCodes.map((code, idx) => (
                  <div key={idx} className="bg-white px-2 py-1 rounded border border-slate-200 text-center">{code}</div>
                ))}
              </div>
              <p className="text-[11px] text-slate-400">Store these codes securely. Each can be used once if your authenticator device is lost.</p>
            </div>

            <div className="pt-2">
              <button
                onClick={() => setShowTotpModal(false)}
                className="w-full py-2.5 bg-violet-600 hover:bg-violet-700 text-white font-bold rounded-xl transition shadow-sm"
              >
                Close & Confirm Setup
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Mandatory Deletion Modal */}
      {showDeleteModal && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
            <div className="flex items-center justify-between pb-3 border-b border-slate-100">
              <h3 className="text-lg font-bold text-rose-600 flex items-center gap-2">
                <AlertTriangle className="w-5 h-5" /> Mandatory Compliance Deletion
              </h3>
              <button onClick={() => setShowDeleteModal(false)} className="text-slate-400 hover:text-slate-600 font-bold text-lg">&times;</button>
            </div>

            <form onSubmit={handleSimulateDeletion} className="space-y-4">
              <div>
                <label className="text-xs font-bold text-slate-700 uppercase tracking-wider">Target Record ID</label>
                <input 
                  type="text" 
                  value={deleteTargetId} 
                  onChange={(e) => setDeleteTargetId(e.target.value)}
                  className="w-full mt-1 px-3 py-2 bg-slate-100 rounded-xl border border-slate-200 font-mono text-sm text-slate-800" 
                />
              </div>

              <div>
                <label className="text-xs font-bold text-slate-700 uppercase tracking-wider">Deletion Reason (Minimum 10 characters) *</label>
                <textarea 
                  rows="3"
                  value={deleteReason}
                  onChange={(e) => setDeleteReason(e.target.value)}
                  placeholder="Specify clear operational or regulatory reason for deletion..."
                  className="w-full mt-1 px-3 py-2 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500 text-sm text-slate-800"
                  required
                ></textarea>
                <span className="text-[11px] text-slate-400 mt-1 block">Current length: {deleteReason.trim().length} / 10 required</span>
              </div>

              <div className="flex gap-3 pt-2">
                <button
                  type="button"
                  onClick={() => setShowDeleteModal(false)}
                  className="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl transition"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="flex-1 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl transition shadow-sm"
                >
                  Authorize Deletion
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

    </div>
  );
}